<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Registrar lesión (CU-04, CU-11 y CU-12; Figura 11). -->
<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="sgsld.vista.fx.RegistroLesionController" styleClass="pantalla">
    <Label text="Registrar lesión" styleClass="titulo-pantalla"/>
    <VBox styleClass="campo">
        <Label text="Jugador" styleClass="etiqueta-campo"/>
        <ComboBox fx:id="comboJugador" prefWidth="545" promptText="Elegir jugador…"/>
    </VBox>
    <Label text="HISTORIAL DE LESIONES (CU-12, AUTOMÁTICO)" styleClass="subtitulo"/>
    <TableView fx:id="tablaHistorial"/>
    <HBox styleClass="encabezado-formulario">
        <Label text="DATOS DE LA NUEVA LESIÓN" styleClass="subtitulo" minWidth="-Infinity"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="etiquetaResultado" styleClass="mensaje-ok" visible="false"/>
    </HBox>
    <GridPane styleClass="formulario">
        <columnConstraints>
            <ColumnConstraints percentWidth="25"/>
            <ColumnConstraints percentWidth="25"/>
            <ColumnConstraints percentWidth="25"/>
            <ColumnConstraints percentWidth="25"/>
        </columnConstraints>
        <VBox styleClass="campo" GridPane.columnIndex="0" GridPane.rowIndex="0">
            <Label text="Tipo de lesión *" styleClass="etiqueta-campo"/>
            <ComboBox fx:id="comboTipo" maxWidth="Infinity" promptText="Elegir…"/>
        </VBox>
        <VBox styleClass="campo" GridPane.columnIndex="1" GridPane.rowIndex="0">
            <Label text="Zona corporal *" styleClass="etiqueta-campo"/>
            <ComboBox fx:id="comboZona" maxWidth="Infinity" promptText="Elegir…"/>
        </VBox>
        <VBox styleClass="campo" GridPane.columnIndex="2" GridPane.rowIndex="0">
            <Label text="Gravedad *" styleClass="etiqueta-campo"/>
            <ComboBox fx:id="comboGravedad" maxWidth="Infinity" promptText="Elegir…"/>
        </VBox>
        <VBox styleClass="campo" GridPane.columnIndex="3" GridPane.rowIndex="0">
            <Label text="Fecha *" styleClass="etiqueta-campo"/>
            <DatePicker fx:id="campoFecha" maxWidth="Infinity"/>
        </VBox>
    </GridPane>
    <VBox styleClass="campo">
        <Label text="Descripción" styleClass="etiqueta-campo"/>
        <TextArea fx:id="campoDescripcion" prefRowCount="2" wrapText="true" maxWidth="680"/>
    </VBox>
    <HBox styleClass="fila-botones">
        <Button fx:id="botonRegistrar" text="Registrar lesión" styleClass="boton-primario" minWidth="-Infinity"
                onAction="#registrar"/>
        <Button text="Cancelar" styleClass="boton-secundario" minWidth="-Infinity" onAction="#limpiar"/>
        <Label text="* Campos obligatorios. No se admiten fechas futuras." styleClass="nota"/>
    </HBox>
</VBox>