<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Ventana principal: menú lateral por rol (sección 6.2) y área de contenido. -->
<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="sgsld.vista.fx.PrincipalController">
    <left>
        <VBox styleClass="menu-lateral">
            <VBox styleClass="menu-cabecera">
                <Label text="SGSLD" styleClass="menu-marca"/>
                <Label fx:id="etiquetaUsuario" styleClass="menu-usuario"/>
            </VBox>
            <VBox fx:id="contenedorOpciones" styleClass="menu-opciones"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Button text="Cerrar sesión" styleClass="menu-opcion,menu-pie" maxWidth="Infinity"
                    onAction="#cerrarSesion"/>
        </VBox>
    </left>
    <center>
        <StackPane fx:id="contenido" styleClass="contenido"/>
    </center>
</BorderPane>