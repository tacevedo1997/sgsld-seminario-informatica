<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Evoluciones y finalización de tratamientos (CU-06). -->
<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="sgsld.vista.fx.EvolucionesController" styleClass="pantalla">
    <Label text="Evoluciones" styleClass="titulo-pantalla"/>
    <Label text="TRATAMIENTOS EN CURSO" styleClass="subtitulo"/>
    <TableView fx:id="tablaTratamientos"/>
    <Label fx:id="tituloEvoluciones" styleClass="subtitulo"/>
    <TableView fx:id="tablaEvoluciones"/>
    <HBox styleClass="encabezado-formulario">
        <Label text="NUEVA EVOLUCIÓN" styleClass="subtitulo" minWidth="-Infinity"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="etiquetaResultado" styleClass="mensaje-ok" visible="false"/>
    </HBox>
    <GridPane styleClass="formulario">
        <columnConstraints>
            <ColumnConstraints percentWidth="22"/>
            <ColumnConstraints percentWidth="22"/>
            <ColumnConstraints percentWidth="56"/>
        </columnConstraints>
        <VBox styleClass="campo" GridPane.columnIndex="0" GridPane.rowIndex="0">
            <Label text="Fecha *" styleClass="etiqueta-campo"/>
            <DatePicker fx:id="campoFecha" maxWidth="Infinity"/>
        </VBox>
        <VBox styleClass="campo" GridPane.columnIndex="1" GridPane.rowIndex="0">
            <Label text="Resultado *" styleClass="etiqueta-campo"/>
            <ComboBox fx:id="comboResultado" maxWidth="Infinity" promptText="Elegir…"/>
        </VBox>
        <VBox styleClass="campo" GridPane.columnIndex="2" GridPane.rowIndex="0">
            <Label text="Observación *" styleClass="etiqueta-campo"/>
            <TextField fx:id="campoObservacion"/>
        </VBox>
    </GridPane>
    <HBox styleClass="fila-botones">
        <Button fx:id="botonRegistrar" text="Registrar evolución" styleClass="boton-primario" minWidth="-Infinity"
                onAction="#registrar"/>
        <Button fx:id="botonFinalizar" text="Registrar y finalizar" styleClass="boton-secundario"
                minWidth="-Infinity" onAction="#registrarYFinalizar"/>
        <Button text="Cancelar" styleClass="boton-secundario" minWidth="-Infinity" onAction="#limpiar"/>
        <Label text="* Campos obligatorios." styleClass="nota"/>
    </HBox>
</VBox>